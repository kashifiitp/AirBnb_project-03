<% layout("./layouts/boilerplate") %>
<body>
    <br>
    <div class="row mt-3">
        <div class="col-8 offset-3">
        <h3>listing Details :</h3>
    </div>
  <div class="card col-6 offset-3 show-card">
  
   <img src="<%= Listing.image %>" class="card-img-top show-img" alt="listing-image">
  <div class="card-body">
    <p class="card-text">
        <b><%= Listing.title %></b>
        <br>
        <%= Listing.description %>
        <br>
        &#8377;<%= Listing.price %>
        <br>
        <%= Listing.location %>
        <br>
        <%= Listing.country %>
    </p>
  </div>
  </div>
    </div>
     <div class="btns">
    <a href="/listings/<%= Listing._id %>/edit" class="btn btn-dark col-1 offset-3 mb-4  new_btn">EDIT</a>
    
    

    <form method="POST" action="/listings/<%= Listing._id %>?_method=DELETE">
        <button class="btn btn-dark offset-3 mb-4 ">DELETE</button>
    </form>
    </div>
    <br>
    <br>
    
   
    
</body>
